# 生产环境配置
VITE_APP_ENV=production

# API 配置（生产环境）
VITE_API_BASE_URL=/api
VITE_GATEWAY_URL=http://your-production-gateway:18080

# 请求配置
VITE_REQUEST_TIMEOUT=30000

# OpenAPI 文档地址（生产环境可能不需要）
VITE_OPENAPI_AUTH_URL=http://your-production-gateway/api/auth/v3/api-docs
VITE_OPENAPI_FILE_URL=http://your-production-gateway/api/file/v3/api-docs
VITE_OPENAPI_MESSAGE_URL=http://your-production-gateway/api/message/v3/api-docs
VITE_OPENAPI_SETTING_URL=http://your-production-gateway/api/setting/v3/api-docs
VITE_OPENAPI_MONITOR_URL=http://your-production-gateway/api/monitor/v3/api-docs