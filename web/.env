# ==================== 应用配置 ====================
# 应用名称
VITE_APP_TITLE=PeachCloud
# 应用版本
VITE_APP_VERSION=1.0.0

# ==================== API 配置 ====================
# API 基础路径（网关地址）
VITE_API_BASE_URL=/api
# 后端网关地址（完整 URL，用于需要直连后端的场景）
VITE_GATEWAY_URL=http://localhost:18080

# ==================== 请求配置 ====================
# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=30000

# ==================== OpenAPI 配置 ====================
# OpenAPI 文档地址（用于代码生成）
VITE_OPENAPI_AUTH_URL=http://localhost:18080/api/auth/v3/api-docs
VITE_OPENAPI_FILE_URL=http://localhost:18080/api/file/v3/api-docs
VITE_OPENAPI_MESSAGE_URL=http://localhost:18080/api/message/v3/api-docs
VITE_OPENAPI_SETTING_URL=http://localhost:18080/api/setting/v3/api-docs
VITE_OPENAPI_MONITOR_URL=http://localhost:18080/api/monitor/v3/api-docs

# ==================== 存储配置 ====================
# Token 存储键名
VITE_TOKEN_KEY=token
# 语言存储键名
VITE_LANGUAGE_KEY=language
# 租户 ID 存储键名
VITE_TENANT_KEY=tenantId

# ==================== 默认值 ====================
# 默认语言
VITE_DEFAULT_LANGUAGE=zh-CN