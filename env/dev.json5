  },

  database: {
    host: "127.0.0.1",
    port: 3306,
    user: "root",
    password: "123456",
    name: "backend-fastapi",
    url: "mysql+aiomysql://root:123456@127.0.0.1:3306/backend-fastapi",
  },

  redis: {
    host: "47.121.112.66",
    port: 6379,
    password: "123456",
    db: 0,
    // url: "redis://:123456@127.0.0.1:6379/0",
  },

  mongo: {
    host: "47.121.112.66",
    port: 27017,
    user: "fastapi",
    password: "123456",
    db: "fastapi",
    auth_source: "fastapi",
    // url: "mongodb://127.0.0.1:27017/backend-fastapi",
  },

  cache: {
    default_expire: 300,
    prefix: "peach-fastapi:",
